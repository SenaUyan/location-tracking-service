# Copy to .env for local development (docker compose provides its own values).
NODE_ENV=development
LOG_LEVEL=info

PORT=3000
WORKER_PORT=3001

DATABASE_URL=postgres://postgres:postgres@localhost:5432/location_tracking
DATABASE_POOL_SIZE=20
REDIS_URL=redis://localhost:6379

# Role based API keys (min. 16 chars). NEVER use these values in production.
API_KEY_ADMIN=dev-admin-key-change-me
API_KEY_INGEST=dev-ingest-key-change-me

# Area entry detection
STATE_TTL_SECONDS=1800
EXIT_BUFFER_METERS=10

# Location validation
MAX_FUTURE_SKEW_SECONDS=300
MAX_LOCATION_AGE_SECONDS=86400

# Areas
POLYGON_MAX_VERTICES=1000

# Rate limiting
RATE_LIMIT_LOCATIONS_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=600

# Worker
WORKER_CONCURRENCY=20

# Data retention for area entry logs (0 = disabled)
LOG_RETENTION_DAYS=0
RETENTION_BATCH_SIZE=5000
RETENTION_CRON="0 3 * * *"

# Observability
OTEL_SERVICE_NAME=location-tracking-service
# Set to e.g. http://localhost:4318 to export traces (see README)
OTEL_EXPORTER_OTLP_ENDPOINT=
